{
  "name": "studyhub",
  "private": true,
  "version": "1.0.1",
  "description": "StudyHub — 个人英语与专业课本地桌面学习客户端（Tauri v2 + Rust）",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "tauri:dev": "npx @tauri-apps/cli@2 dev",
    "tauri:build": "npx @tauri-apps/cli@2 build --bundles nsis",
    "clean": "rm -rf dist release src-tauri/target",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/lib/dictionary.test.ts src/lib/vocabLogic.test.ts src/lib/quizLogic.test.ts src/lib/markdown.test.ts src/lib/translator.test.ts src/lib/tauriContract.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.5",
    "@vitejs/plugin-react": "^6.1.1",
    "chokidar": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
