{
  "name": "studyhub",
  "private": true,
  "version": "1.0.0",
  "description": "StudyHub — 个人英语与专业课本地桌面学习客户端",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "electron:build-main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=electron/main.cjs --external:electron",
    "electron:start": "npm run build && npm run electron:build-main && electron .",
    "electron:pack": "npm run build && npm run electron:build-main && electron-builder --win nsis portable --publish never",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/lib/dictionary.test.ts src/lib/vocabLogic.test.ts src/lib/quizLogic.test.ts electron/ipc.test.ts"
  },
  "build": {
    "appId": "com.joel.studyhub",
    "productName": "StudyHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "artifactName": "StudyHub-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "StudyHub-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "chokidar": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
